{
  "name": "loong",
  "private": true,
  "version": "3.0.0-beta.1",
  "type": "module",
  "author": "Professor Hamza Mahmoud Ramadan",
  "description": "Loong — a desktop coding agent. One brain, real tools, a UI built to be read.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,agent -c cyan,magenta \"vite\" \"node server/start.ts\"",
    "dev:front": "vite",
    "dev:agent": "node server/start.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build && node scripts/build-agent.mjs",
    "build:electron": "npm run install:desktop && npm run build && electron-builder --dir",
    "build:exe": "npm run install:desktop && npm run build && electron-builder --win nsis --x64",
    "test": "node --test --experimental-test-coverage --import tsx --import ./tests/preload.ts ./tests/*.test.ts",
    "lint": "tsc --noEmit",
    "audit:ui": "node scripts/audit-ui.mjs",
    "postinstall": "patch-package",
    "preinstall": "node scripts/check-node.mjs",
    "desktop": "electron .",
    "build:linux": "npm run install:desktop && npm run build && electron-builder --linux AppImage --x64",
    "smoke:bundle": "node scripts/smoke-bundle.mjs",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "checksums": "node scripts/checksums.mjs",
    "eval:list": "node --import tsx scripts/evaluate.ts --list",
    "eval:check": "node --import tsx scripts/evaluate.ts --self-test",
    "eval": "node --import tsx scripts/evaluate.ts",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "install:desktop": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@ag-ui/core": "^1.0.3",
    "@ai-sdk/anthropic": "^4.0.81",
    "@ai-sdk/google": "^4.0.98",
    "@ai-sdk/mcp": "^2.0.77",
    "@ai-sdk/openai": "^4.0.95",
    "@ai-sdk/openai-compatible": "^3.0.70",
    "@hono/node-server": "^2.1.5",
    "ai": "^7.0.142",
    "esbuild": "^0.28.2",
    "hono": "^4.13.13",
    "motion": "^14.3.0",
    "node-pty": "^1.1.0",
    "pixelmatch": "^5.3.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.5",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "44.9.3",
    "electron-builder": "^25.1.8",
    "patch-package": "^8.0.1",
    "rcedit": "^5.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.loong.agent",
    "productName": "Loong",
    "directories": {
      "output": "app"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-agent",
        "to": "agent"
      },
      {
        "from": "dist-agent/browsers.json",
        "to": "browsers.json"
      },
      {
        "from": "dist-agent/package.json",
        "to": "package.json"
      }
    ],
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "perMachine": false,
      "shortcutName": "Loong",
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}",
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  },
  "productName": "Loong",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  }
}
